<%- include('../include/head.ejs') %>

</head>

<body>
  <%- include('../include/navigation.ejs') %>
        <div class="container-fluid d-flex justify-content-center align-items-center">
          <div class="card-body container">
              <header>إضافة مستخدم</header>

              <form action="/admin/<% if (editing) { %>editStudent<% } else { %>signStudent<% } %>" class="form" method="POST">
                <div class="column">
                  <div class="input-box">
                    <label for="name">الاسم الكامل</label>
                    <input type="text"
                      class="form-control" 
                      name="name" 
                      id="name"
                      placeholder="أدخل الاسم الكامل" 
                      value="<% if (editing) { %><%= student.name %><% } %>"
                      required />
                  </div>
                  <div class="input-box">
                    <label for="nationalNumber">الرقم الوطني</label>
                    <input type="number"
                      class="form-control"
                      name="nationalNumber" 
                      id="nationalNumber"
                      placeholder="أدخل الرقم الوطني" 
                      value="<% if (editing) { %><%= student.nationalNumber %><% } %>"
                      required />
                  </div>
                </div>
                <div class="column">
                  <div class="input-box">
                    <label for="militaryNumber">رقم التجنيد</label>
                    <input type="number" 
                      class="form-control"
                      name="militaryNumber" 
                      id="militaryNumber"
                      placeholder="أدخل رقم التجنيد " 
                      value="<% if (editing) { %><%= student.militaryNumber %><% } %>"
                      required />
                  </div>
                  <div class="input-box">
                    <label for="birthdate">تاريخ الولادة</label>
                    <input type="date"
                      class="form-control" 
                      name="birthdate" 
                      id="birthdate"
                      placeholder="أدخل تاريخ الولادة"
                      value="<% if (editing) { %><%= new Date(student.birthdate).toISOString().substring(0, 10) %><% } %>" 
                      required />
                  </div>
                </div>
                <div class="column">
                  <div class="input-box">
                    <label for="phoneNumber">رقم الموبايل</label>
                    <input type="number"
                      class="form-control" 
                      name="phoneNumber"
                      id="phoneNumber"
                      placeholder="أدخل رقم الموبايل"
                      value="<% if (editing) { %><%= student.phoneNumber %><% } %>"  
                      required />
                  </div>
                  <div class="input-box">
                    <label for="delayedTo">أجل إلى تاريخ</label>
                    <input type="date" 
                      class="form-control"
                      name="delayedTo"
                      id="delayedTo"
                      placeholder="أدخل تاريخ الولادة" 
                      value="<% if (editing) { %><%= new Date(student.delayedTo).toISOString().substring(0, 10) %><% } %>"  
                      required />
                  </div>
                </div>
                <div class="column">
                  <div class="input-box">
                    <label for="select-search" class="form-label">الشعبة</label>
                    <select class="form-select form-control"
                            name="division" 
                            id="division" 
                            placeholder="اختر الشعبة...">
                          <option value="">اختر الشعبة</option>
                          <option value="Qaymariya" <% if (editing) { if (student.division === 'Qaymariya') { %>selected<% } } %>>قيمرية</option>
                          <option value="Salihiya" <% if (editing) { if (student.division === 'Salihiya') { %>selected<% } } %>>صالحية</option>
                          <option value="Mezzeh" <% if (editing) { if (student.division === 'Mezzeh') { %>selected<% } } %>>مزة</option>
                          <option value="Amara" <% if (editing) { if (student.division === 'Amara') { %>selected<% } } %>>عمارة</option>
                          <option value="Maidan" <% if (editing) { if (student.division === 'Maidan') { %>selected<% } } %>>ميدان</option>
                      </select>               
                  </div> 
                  <div class="input-box">
                    <label for="address">عنوان السكن</label>
                    <input type="text"
                      class="form-control"
                      name="address"
                      id="address" 
                      placeholder="أدخل عنوان السكن" 
                      value="<% if (editing) { %><%= student.address %><% } %>"  
                      required />
                  </div>
                </div>
                <div class="input-box">
                  <label for="email">العنوان البريدي</label>
                  <input type="text"
                    class="form-control"
                    name="email"
                    id="email" 
                    placeholder="أدخل العنوان البريدي"
                    value="<% if (editing) { %><%= student.email %><% } %>"  
                    required />
                </div>
                <div class="input-box">
                  <label for="password">كلمة السر</label>
                  <input type="password"
                    class="form-control"
                    name="password"
                    id="password" 
                    placeholder="أدخل كلمة السر" 
                    required />
                </div>
                <% if (editing) { %>
                  <input type="hidden" value="<%= student._id %>" name="studentId">
                <% } %>
                <div class="col-md-12">
                  <button class="btn btn-primary w-100 py-8 fs-4 mb-4 rounded-2" type="submit">
                    <% if (editing) { %>تعديل<% } else { %>إضافة<% } %>
                  </button>
                </div>
              </form>
          </div>
        </div>
  </div>
</div>
<%- include('../include/end.ejs') %>