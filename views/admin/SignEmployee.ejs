<%- include('../include/head.ejs') %>

</head>

<body>
  <%- include('../include/navigation.ejs') %>
      <div class="container-fluid d-flex justify-content-center align-items-center">
        <div class="card-body container">
                <header>إضافة موظف</header>
                <% if (errorMessage) { %>
                  <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-circle-filled fs-5 me-2"></i>
                    <div><%= errorMessage %></div>
                  </div>
                <% } %>
                <form action="/admin/<% if (editing) { %>editEmployee<% } else { %>signEmployee<% } %>" class="form" method="POST" novalidate>
                  <div class="input-box">
                    <label for="name">الاسم الكامل</label>
                    <input type="text" 
                      class="form-control <%= validationErrors.find(e => e.path === 'name') ? 'is-invalid' : '' %>"
                      name="name" 
                      id="name"
                      placeholder="أدخل الاسم الكامل" 
                      value="<% if (editing || hasError) { %><%= employee.name %><% } %>"
                      required />
                  </div>
                  <div class="input-box">
                        <label for="select-search" class="form-label">الشعبة</label>
                        <select class="form-select form-control <%= validationErrors.find(e => e.path === 'division') ? 'is-invalid' : '' %>"
                            name="division" 
                            id="division" 
                            placeholder="اختر الشعبة...">
                          <option value="">اختر الشعبة</option>
                          <option value="Qaymariya" <% if (editing) { if (employee.division === 'Qaymariya') { %>selected<% } } %>>قيمرية</option>
                          <option value="Salihiya" <% if (editing) { if (employee.division === 'Salihiya') { %>selected<% } } %>>صالحية</option>
                          <option value="Mezzeh" <% if (editing) { if (employee.division === 'Mezzeh') { %>selected<% } } %>>مزة</option>
                          <option value="Amara" <% if (editing) { if (employee.division === 'Amara') { %>selected<% } } %>>عمارة</option>
                          <option value="Maidan" <% if (editing) { if (employee.division === 'Maidan') { %>selected<% } } %>>ميدان</option>
                      </select>              
                  </div>  
                  <div class="input-box">
                    <label for="email">العنوان البريدي</label>
                    <input 
                      class="form-control <%= validationErrors.find(e => e.path === 'email') ? 'is-invalid' : '' %>"
                      type="email" 
                      name="email" 
                      id="email" 
                      placeholder="أدخل العنوان البريدي" 
                      value="<% if (editing || hasError) { %><%= employee.email %><% } %>"
                      required />
                  </div>
                  <div class="input-box">
                    <label for="password">كلمة السر</label>
                    <input 
                      class="form-control <%= validationErrors.find(e => e.path === 'password') ? 'is-invalid' : '' %>"
                      type="password" 
                      name="password" 
                      id="password"
                      placeholder="أدخل كلمة السر" 
                      value="<% if (hasError) { %><%= employee.email %><% } %>"
                      required />
                  </div>
                  <% if (editing ) { %>
                    <input type="hidden" value="<%= employee._id %>" name="employeeId">
                  <% } %>
                  <div class="col-md-12">
                    <button class="btn btn-primary w-100 py-8 fs-4 mb-4 rounded-2" type="submit">
                      <% if (editing) { %>تعديل<% } else { %>إضافة<% } %>
                    </button>
                  </div>
                </form>
              
        </div>
      </div>
  </div>
</div>
<%- include('../include/end.ejs') %>