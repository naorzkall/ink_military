<%- include('../include/head.ejs') %>
<style>
  .table th, .table td {
    padding: 1rem;
    font-size: 1.25rem;
  }
  .table td .btn {
  width: 80px;  /* or whatever width you prefer */
  text-align: center;
  }

  .table td form {
    margin: 0;
  }

  .table td .d-flex {
    gap: 10px;
  }
  </style>
</head>
<body>
  <%- include('../include/navigation.ejs') %>
  <div class="container-fluid">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title fw-semibold mb-4">إدارة المستخدمين</h5>
        <form action="/admin/manageUsers" method="GET">
          <div class="row mb-3">
            <div class="col-md-4">
              <select class="form-select" name="userType" onchange="this.form.submit()">
                <option value="all" <%= currentUserType === 'all' ? 'selected' : '' %>>الكل</option>
                <option value="Employee" <%= currentUserType === 'Employee' ? 'selected' : '' %>>الموظفين</option>
                <option value="Student" <%= currentUserType === 'Student' ? 'selected' : '' %>>الطلاب</option>
                <option value="Admin" <%= currentUserType === 'Admin' ? 'selected' : '' %>>الآدمن</option>
              </select>
            </div>
            <div class="col-md-8">
              <div class="input-group">
                <input type="text" class="form-control" name="search" placeholder="ابحث" aria-label="Search" aria-describedby="button-addon2" value="<%= searchQuery %>">
                <button class="btn" type="submit" id="button-addon2">
                  <i class="ti ti-search"></i>
                </button>
              </div>
            </div>
          </div>
        </form>
        <div class="table-responsive">
          <table class="table text-nowrap mb-0 align-middle">
            <thead class="text-dark fs-4">
              <tr>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">الاسم</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">الدور</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">الإيميل</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">إجراءات</h6>
                </th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(user) { %>
                <tr>
                  <td class="border-bottom-0"><h6 class="fw-semibold mb-0"><%= user.name %></h6></td>
                  <td class="border-bottom-0">
                    <p class="mb-0 fw-normal"><%= user.user_type %></p>
                  </td>
                  <td class="border-bottom-0">
                    <p class="mb-0 fw-normal"><%= user.email %></p>
                  </td>
                  <td class="border-bottom-0">
                    <a href="/admin/edit-user/<%= user._id %>?edit=true" class="btn btn-primary btn-sm mb-2">تعديل</a>
                    <form action="/admin/delete-user/<%= user._id %>" method="POST">
                      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد من حذف هذا المستخدم؟')">حـــــذف</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../include/end.ejs') %>