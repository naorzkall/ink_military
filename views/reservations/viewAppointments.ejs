<%- include('../include/head.ejs') %>
</head>
<body>
  <%- include('../include/navigation.ejs') %>
      <div class="container-fluid vh-100">
          <div class="row">
              <div class="row card-container">
                <% if (appointments.length > 0) { %>
                  <% appointments.forEach(appointment => { %>
                    <div class="col-lg-4 col-md-6 mb-4">
                      <div class="card shadow-sm">
                        
                        <div class="card-body">
                          <h3><%= appointment.name %></h3>
                          <p class="card-text">تاريخ الحجز: <strong><%= moment(appointment.date).format('YYYY-MM-DD') %></strong></p>
                          <p class="card-text">الوقت: <strong><%= appointment.time %></strong></p>
                          <p class="card-text">القسم: <strong><%= appointment.division %></strong></p>
                          <a href="/admin/signStudent" class="btn btn-primary">معالجة الطلب</a>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="col-12 no-appointments">
                    <p class="text-center">لا توجد مواعيد متاحة لهذا اليوم.</p>
                  </div>
                <% } %>
              </div>
          </div>
      </div>

  </div>
</div>
  <script>
    document.getElementById('division').addEventListener('change', function() {
      document.getElementById('divisionForm').submit();
    });
  </script>
<%- include('../include/end.ejs') %>
