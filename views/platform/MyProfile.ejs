<%- include('../include/head.ejs') %>

</head>

<body>
  <%- include('../include/navigation.ejs') %>
    <!-- Profile Content Start -->
          <div class="container-fluid d-flex justify-content-center align-items-center vh-100 col-md-10 col-lg-9 col-xxl-5 ">
            <div class="card-body container">
                
                <div class="d-flex align-items-center mb-3">
                  <img src="<%= student.imageUrl || '/assets/images/profile/user-1.jpg' %>" alt="Profile Picture" width="80" height="80" class="rounded-circle mr-3">
                  <div>
                    <h6 class="mb-0 spacing-r"><%= student.name %></h6>
                    <p class="mb-0 text-muted spacing-r"><%= student.email %></p>
                  </div>
                </div>
                <form>
                  <div class="mb-4">
                    <label for="delayedTo">تاريخ انتهاء التأجيل </label>
                    <input type="text" class="form-control" id="delayedTo" value="<%= student.delayedTo ? student.delayedTo.toLocaleDateString() : 'غير محدد' %>" disabled>
                  </div>
                  <div class="mb-4">
                    <label for="email">البريد الالكتروني</label>
                    <input type="email" class="form-control" id="email" value="<%= student.email %>" disabled>
                  </div>
                  <div class="mb-4">
                    <label for="phoneNumber">رقم الموبايل</label>
                    <input type="text" class="form-control" id="phoneNumber" value="<%= student.phoneNumber || 'غير محدد' %>" disabled>
                  </div>
                  <div class="mb-4">
                    <label for="address">عنوان السكن</label>
                    <input type="text" class="form-control" id="address" value="<%= student.address || 'غير محدد' %>" disabled>
                  </div>
                  <button type="submit" class="btn btn-primary">حفظ التغيرات</button>
                </form>
 
            </div>   
          </div>

  </div>
</div>
<%- include('../include/end.ejs') %>