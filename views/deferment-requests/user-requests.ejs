<%- include('../include/head.ejs') %>
</head>

<body>
  <%- include('../include/navigation.ejs') %>
  <div class="container-fluid vh-100">
    <div class="row mt-4">
      <% if (requests.length > 0) { %>
        <% requests.forEach(request => { %>
          <div class="col-md-4 mb-4">
            <div class="card">
              <div class="card-header">
                <h2><%= request.userId.name %></h2>
              </div>
              <div class="card-body">
                <!-- <h5 class="card-title"><%= request.division %></h5> -->
                <p class="card-text">حالة الطلب: <%= request.status %></p>
                <p class="card-text">تاريخ الطلب: <%= new Date(request.createdAt).toLocaleDateString() %></p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-md-12">
          <p class="text-center">لا توجد طلبات تاجيل مرسلة في الوقت الراهن</p>
        </div>
      <% } %>
    </div>
  </div>
  <%- include('../include/end.ejs') %>
</body>
</html>
