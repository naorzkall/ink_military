<%- include('../include/head.ejs') %>
</head>

<body>
  <%- include('../include/navigation.ejs') %>
  <div class="container-fluid vh-100">
    <div class="row mt-4">
      <% if (mes) { %>
        <div class="col-md-12">
          <div class="alert alert-info" role="alert">
            <%= mes %>
          </div>
        </div>
      <% } %>
      <% if (requests.length > 0) { %>
        <% requests.forEach(request => { %>
          <div class="col-md-4 mb-4">
            <div class="card">
              <div class="card-header">
                <h2><%= request.userId.name %></h2>
              </div>
              <div class="card-body">
                <p class="card-text">حالة الطلب: <%= request.status %></p>
                <p class="card-text">تاريخ الطلب: <%= new Date(request.createdAt).toLocaleDateString() %></p>
                
                <% if (request.status === 'مقبول' && request.defermentDocumentUrl) { %>
                  <div class="mt-3">
                    <h5>مستند التأجيل:</h5>
                    <a href="/<%= request.defermentDocumentUrl %>" class="btn btn-primary" download>
                      <i class="ti ti-download me-2"></i>تحميل المستند
                    </a>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-md-12">
          <p class="text-center">لا يوجد طلب تاجيل مرسل في الوقت الراهن</p>
        </div>
      <% } %>
    </div>
  </div>
<%- include('../include/end.ejs') %>
