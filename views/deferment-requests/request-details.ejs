<%- include('../include/head.ejs') %>
</head>

<body>
  <%- include('../include/navigation.ejs') %>
  <div class="container mt-5">
    <div class="card">
      <div class="card-header">
        <h1 class="h3">تفاصيل الطلب</h1>
      </div>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-6">
            <p><strong>رقم الطلب:</strong> <%= request._id %></p>
          </div>
          <div class="col-md-6">
            <p><strong>المستخدم:</strong> <%= request.userId.name %> (<%= request.userId.email %>)</p>
          </div>
        </div>
        <div class="row mb-3">
          <div class="col-md-6">
            <p><strong>القسم:</strong> <%= request.division %></p>
          </div>
          <div class="col-md-6">
            <p><strong>حالة الطلب:</strong> <span class="badge badge-info"><%= request.status %></span></p>
          </div>
        </div>
        <div class="row mb-3">
          <div class="col-md-6">
            <p><strong>صورة الهوية:</strong></p>
            <img src="/<%= request.identityUrl %>" class="img-fluid img-thumbnail" alt="Identity Document">
          </div>
          <div class="col-md-6">
            <p><strong>صورة المصدقة الدراسية:</strong></p>
            <img src="/<%= request.certificateUrl %>" class="img-fluid img-thumbnail" alt="Certificate Document">
          </div>
        </div>

        
          <form action="/deferment-requests/request/<%= request._id %>/approve" method="POST" class="mb-3">
            <button type="submit" class="btn btn-success">الموافقة على الطلب</button>
          </form>
          <form action="/deferment-requests/request/<%= request._id %>/reject" method="POST" class="mb-3">
            <div class="form-group">
              <label for="feedback">سبب الرفض</label>
              <textarea class="form-control" id="feedback" name="feedback" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-danger">رفض الطلب</button>
          </form>
        
      </div>
    </div>
  </div>
  <script src="/path/to/your/scripts.js"></script>
  <%- include('../include/end.ejs') %>
</body>
</html>
