<%- include('../include/head.ejs') %>

</head>

<body>
  <%- include('../include/navigation.ejs') %>
    <!-- Profile Content Start -->
            <div class="container-fluid">
                <div class="row">
                <h2 class="mb-4">آخر الأخبار</h2>
                
                <% if (news && news.length > 0) { %>
                <div class="row">
                    <% news.forEach(item => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                        <img src="/<%= item.imageUrl %>" class="card-img-top" alt="<%= item.title %>">
                        <div class="card-header">
                            <h4><%= item.title %></h4>
                        </div>
                        <div class="card-body">
                            <p class="card-text">تاريخ النشر: <%= new Date(item.createdAt).toLocaleDateString('ar-EG') %></p>
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newsModal<%= item._id %>">
                            اقرأ المزيد
                            </button>
                        </div>
                        </div>
                    </div>
            
                    <!-- Modal for news content -->
                    <div class="modal fade" id="newsModal<%= item._id %>" tabindex="-1" aria-labelledby="newsModalLabel<%= item._id %>" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="newsModalLabel<%= item._id %>"><%= item.title %></h5>
                            </div>
                            <div class="modal-body">
                            <img src="/<%= item.imageUrl %>" class="img-fluid mb-3" alt="<%= item.title %>">
                                <p><%= item.body %></p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                            </div>
                        </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <div class="col-md-12">
                    <p>لا توجد أخبار متاحة حالياً</p>
                </div>
                <% } %>
                </div>
            </div>
    </div>
</div>
<%- include('../include/end.ejs') %>